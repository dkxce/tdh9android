<?xml version="1.0" encoding="utf-8"?>
<!-- Disable backups entirely (settings/logs are per-install local). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>